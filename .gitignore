node_modules/

# Logs
logs/
*.log
npm-debug.log*

# Test / coverage artefacts
coverage/
.tmp/
tmp/
*.tmp

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
