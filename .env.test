# Environment used by `npm test` (loaded with node --env-file).
# Contains no secrets: these values are for the automated test run only.
NODE_ENV=test
SESSION_SECRET=test-secret-value-not-used-in-production-000000
DATABASE_FILE=./tmp/test-default.db
APP_TIMEZONE=UTC
SLOT_MINUTES=60
BOOKING_WINDOW_DAYS=21
BOOKING_LEAD_HOURS=2
MAX_ACTIVE_REQUESTS=5
