# ---------------------------------------------------------------------------
# PeerLearn configuration example.
# Copy to `.env` and adjust. NEVER commit the real `.env` file.
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# HTTP server
HOST=127.0.0.1
PORT=3000

# Secret used to sign flash cookies. REQUIRED in production (min 32 chars).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-insecure-secret-change-me

# SQLite database file (relative paths resolve from the project root)
DATABASE_FILE=./data/peerlearn.db

# Institution timezone. All availability and session times are expressed in it.
# Any IANA zone, e.g. UTC, Africa/Johannesburg, Europe/London, America/New_York
APP_TIMEZONE=UTC

# Public name shown in the UI
APP_NAME=PeerLearn

# Symbol used when a tutor publishes an indicative rate (no money is processed)
CURRENCY_SYMBOL=$

# Booking rules
SLOT_MINUTES=60          # length of one bookable slot
BOOKING_WINDOW_DAYS=21   # how far ahead slots are offered
BOOKING_LEAD_HOURS=2     # minimum notice before a session may start
MAX_ACTIVE_REQUESTS=5    # max simultaneous pending requests per student

# Session lifetime in hours (default 7 days)
SESSION_TTL_HOURS=168

# Set to true only when running behind a reverse proxy that sets
# X-Forwarded-For / X-Forwarded-Proto, otherwise client IPs can be spoofed.
TRUST_PROXY=false

# Credentials used by `npm run seed` to create the first admin account.
# Use a strong password; the seed script only ever writes a scrypt hash.
SEED_ADMIN_EMAIL=admin@peerlearn.test
SEED_ADMIN_PASSWORD=ChangeMe-Admin-2026
